+            uint flags = 0;
+            flags |= FromPlatform(this._Version.Platform);
+            flags |= (uint)this._Version.CompressionVersion << 8;
+
+            output.WriteValueU32(Signature, endian);
+            output.WriteValueU32((uint)this._Version.FileVersion, endian);
+            output.WriteValueU32(flags, endian);
+            output.WriteValueU32(0, endian); // unknown0C (locale tables, world archives only)
+            output.WriteValueU32(0, endian); // unknown10
+            output.WriteValueS32(this._Entries.Count, endian);
+
+            var entries = new List<Entry<T>>(this._Entries);
+            entries.Sort((x, y) => Comparer<T>.Default.Compare(x.NameHash, y.NameHash));
+            foreach (var entry in entries)
+            {
+                entrySerializer.Serialize(output, entry, endian);
+            }
+
+            output.WriteValueU32(0, endian); // localization count
+            output.WriteValueU32(0, endian); // unknown, zero in shipped FC3 archives
         }
 
